# Supabase server-side access
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Source for newly detected Shopify stores
BUILTWITH_API_KEY=

# Protects Vercel cron endpoint
CRON_SECRET=

# Basic-auth protection for /admin and /api/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Max candidates checked per daily run
DISCOVERY_LIMIT=60
