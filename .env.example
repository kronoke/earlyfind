# Required: Supabase server-side access
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required: protect cron and admin routes
CRON_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional paid source. Leave blank while using free batch discovery.
